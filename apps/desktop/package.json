{
  "name": "vips-thumbnail-desktop",
  "version": "1.1.1",
  "private": true,
  "description": "瞬图压缩桌面端",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "electron-vite build && electron-builder --win --config electron-builder.yml",
    "dist:win": "pnpm build:icon && pnpm build && electron-builder --win --x64 --config electron-builder.yml",
    "dist:mac:universal": "pnpm build:icon && pnpm build && electron-builder --mac dmg --universal -c.asar=false --config electron-builder.yml",
    "dist:mac:arm64": "pnpm build:icon && pnpm build && electron-builder --mac dmg --arm64 --config electron-builder.yml",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build:icon": "node scripts/make-icon.mjs"
  },
  "devDependencies": {
    "@giszhc/vips-thumbnail-core": "workspace:*",
    "@playwright/test": "1.62.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tanstack/react-virtual": "3.14.8",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "lucide-react": "1.27.0",
    "png-to-ico": "3.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.7",
    "zustand": "5.0.14"
  },
  "author": {
    "name": "giszhc",
    "email": "shuntool@163.com"
  }
}
